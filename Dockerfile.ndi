FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NDI_LIBRARY_PATH=/opt/ndi/libndi.so \
    NDI_DATA_DIR=/app/ndi-data \
    NDI_STATUS_FILE=/app/ndi-data/status.json \
    NDI_CONFIG_DIR=/opt/ndi-config \
    LD_LIBRARY_PATH=/opt/ndi \
    DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket

WORKDIR /app
# Runtime is provided privately at execution time, never downloaded/copied here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libavahi-client3 libavahi-common3 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home app \
    && mkdir -p /app/ndi-data \
    && chown app:app /app/ndi-data
COPY requirements.txt requirements-ndi.txt ./
RUN pip install --no-cache-dir -r requirements-ndi.txt
COPY config.py ndi_sender.py ndi_status.py ndi_service.py ./
COPY assets ./assets
USER 10001:10001
HEALTHCHECK --interval=10s --timeout=5s --start-period=120s --retries=3 \
    CMD ["python", "ndi_status.py"]
CMD ["python", "-u", "ndi_service.py"]
