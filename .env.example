# Web: todas las interfaces, puerto 8095.
HOST=0.0.0.0
PORT=8095
ROTATE_SECONDS=15
REFRESH_SECONDS=180
MAX_ITEMS=14

# NDI: Linux en Docker host networking; Windows sigue disponible para desarrollo.
NDI_SOURCE_NAME=ED_DEBER_TITULARES_ALPHA
# Si la web esta en otra maquina, indicar su URL completa:
# HEADLINES_API_URL=https://noticias.grupoeldeber-corp.com/api/headlines
# Prueba LAN antes de DNS/TLS (enruta por Host en Traefik):
# HEADLINES_API_URL=http://noticias.grupoeldeber-corp.com/api/headlines
# Si no se encuentra el runtime automaticamente:
# NDI_DLL_PATH=C:\Program Files\NDI\NDI 6 Tools\Runtime\Processing.NDI.Lib.x64.dll
# DATA_DIR=C:\datos\el-deber

# Dokploy / Linux: rutas del HOST Ubuntu, nunca subir SDK/runtime/config privado.
NDI_FPS=30
NDI_WEB_LOOPBACK_PORT=18095
HEADLINES_API_URL=http://127.0.0.1:18095/api/headlines
NDI_RUNTIME_HOST_DIR=/opt/noticias-lateral/ndi-runtime
NDI_CONFIG_HOST_DIR=/opt/noticias-lateral/ndi-config
NDI_LIBRARY_PATH=/opt/ndi/libndi.so
NDI_STALL_SECONDS=30
NDI_STARTUP_SECONDS=120
# Si cambias NDI_WEB_LOOPBACK_PORT, ajustar tambien HEADLINES_API_URL.
# En Windows: quitar NDI_LIBRARY_PATH de Linux o indicar la DLL x64 local;
# ajustar HEADLINES_API_URL a la API web local/remota correspondiente.
