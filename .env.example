# Ejecucion local. En Compose el puerto interno siempre es 8095, sin publicacion.
HOST=0.0.0.0
PORT=8095
ROTATE_SECONDS=15
REFRESH_SECONDS=180
MAX_ITEMS=14

# Dokploy: copiar el nombre REAL obtenido con docker inspect, sin adivinarlo.
# Obligatorio para Compose; no crear un volumen nuevo.
# HEADLINES_VOLUME_NAME=nombre-real-del-volumen-existente

# Cola persistida; la salida se agrega al mezclador como fuente de navegador.
# DATA_DIR=C:\datos\el-deber
