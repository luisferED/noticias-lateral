# Web: todas las interfaces, puerto 8095.
HOST=0.0.0.0
PORT=8095
ROTATE_SECONDS=15
REFRESH_SECONDS=180
MAX_ITEMS=14

# NDI: ejecutar en una PC Windows de 64 bits de la red de emision.
NDI_SOURCE_NAME=ED_DEBER_TITULARES_ALPHA
# Si la web esta en otra maquina, indicar su URL completa:
# HEADLINES_API_URL=https://noticias.grupoeldeber-corp.com/api/headlines
# Prueba LAN antes de DNS/TLS (enruta por Host en Traefik):
# HEADLINES_API_URL=http://noticias.grupoeldeber-corp.com/api/headlines
# Si no se encuentra el runtime automaticamente:
# NDI_DLL_PATH=C:\Program Files\NDI\NDI 6 Tools\Runtime\Processing.NDI.Lib.x64.dll
# DATA_DIR=C:\datos\el-deber
